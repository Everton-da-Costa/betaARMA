print.citation <- function(x, ...) {
  cat("To cite the betaARMA package in publications, please use:\n\n")
  print(x$pkg, style = "Bibtex")
  
  cat("\nTo cite the penalized maximum likelihood estimation (PMLE) methodology, please use:\n\n")
  print(x$bjps, style = "Bibtex")
  
  cat("\nTo cite the application and link function selection methodology, please use:\n\n")
  print(x$jh, style = "Bibtex")
}